{
  "schema_version": "givecare.module/v2",
  "repository": "research-bench",
  "owns": "InvisibleBench: checks, scenarios, the scan engine, the leaderboard, and the public evals dataset (evals/)",
  "check": "scripts/check.sh",
  "produces": [
    {
      "id": "gc-bench.web-benchmark-release/v5",
      "path": "data/releases/web-bench-release.tar.gz",
      "for": [
        "gc-web"
      ]
    },
    {
      "id": "gc-bench.run-record/v1",
      "path": "results",
      "for": [
        "research-evidence"
      ]
    },
    {
      "id": "gc-evals.gold-case/v1",
      "path": "evals/data/all.jsonl",
      "for": [
        "research-bench"
      ]
    }
  ],
  "consumes": [
    {
      "id": "gc-evals.gold-case/v1",
      "from": "research-bench",
      "pin": "private/data/imports/evals/materialization.json"
    },
    {
      "id": "@givecare/tools.InstrumentExport",
      "from": "research-tools"
    },
    {
      "id": "givecare.protocol",
      "from": "."
    }
  ]
}
