{
  "schema_version": "givecare.module/v2",
  "repository": "invisiblebench",
  "owns": "InvisibleBench: public cases, Inspect generation and judging, reports, and versioned benchmark releases",
  "check": "scripts/check.sh",
  "produces": [
    {
      "id": "gc-bench.web-benchmark-release/v7",
      "path": "data/releases/web-bench-release.tar.gz",
      "for": [
        "web"
      ]
    },
    {
      "id": "gc-bench.run-record/v1",
      "path": "results",
      "for": [
        "research"
      ]
    }
  ],
  "consumes": [
    {
      "id": "givecare.protocol",
      "from": "."
    }
  ]
}
