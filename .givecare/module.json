{
  "schema_version": "givecare.module/v2",
  "repository": "invisiblebench",
  "owns": "InvisibleBench: checks, scenarios, the scan engine, the leaderboard, and private held-out evaluation operations",
  "check": "scripts/check.sh",
  "produces": [
    {
      "id": "gc-bench.web-benchmark-release/v5",
      "path": "data/releases/web-bench-release.tar.gz",
      "for": [
        "web"
      ]
    },
    {
      "id": "gc-bench.run-record/v1",
      "path": "results",
      "for": [
        "research"
      ]
    }
  ],
  "consumes": [
    {
      "id": "gc-evals.gold-case/v1",
      "from": "care-evals",
      "pin": "private/data/imports/care-evals/materialization.json"
    },
    {
      "id": "givecare.protocol",
      "from": "."
    }
  ]
}
